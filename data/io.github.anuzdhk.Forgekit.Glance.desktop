[Desktop Entry]
Type=Application
Name=Glance
Comment=Quick preview of any file
Exec=forgekit-gtk --glance %f
Icon=io.github.anuzdhk.Forgekit
NoDisplay=true
Categories=Utility;
MimeType=image/png;image/jpeg;image/webp;image/gif;video/mp4;video/webm;audio/mpeg;audio/flac;text/plain;text/markdown;application/pdf;application/zip;application/x-tar;inode/directory;
