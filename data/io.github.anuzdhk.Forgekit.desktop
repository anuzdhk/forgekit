[Desktop Entry]
Type=Application
Name=Forgekit
Comment=All-in-one power tools for Linux
Exec=forgekit-gtk
Icon=io.github.anuzdhk.Forgekit
Categories=Utility;
Keywords=powertoys;color;picker;rename;hosts;resize;ocr;launcher;clipboard;shelf;theme;environment;
StartupNotify=true
Actions=spark;shelf;clipstack;eyedrop;glyphgrab;

[Desktop Action spark]
Name=Spark launcher
Exec=forgekit-gtk spark

[Desktop Action shelf]
Name=Open DropShelf
Exec=forgekit-gtk --shelf

[Desktop Action clipstack]
Name=Clipboard history
Exec=forgekit-gtk clipstack

[Desktop Action eyedrop]
Name=Pick a color
Exec=forgekit eyedrop

[Desktop Action glyphgrab]
Name=Grab text from screen
Exec=forgekit glyphgrab
